import fs from 'node:fs';
import path from 'node:path';
import { isIP } from 'node:net';

const DEFAULTS = {
  primary: '82.68.70.162',
  secondary: '',
  useSecondary: false,
  timeout: 5000,
  icannTlds: []
};

function normalizeTld(value) {
  const tld = String(value || '')
    .trim()
    .toLowerCase()
    .replace(/^\./, '');

  if (
    !tld ||
    tld.length > 63 ||
    tld.includes('.') ||
    !/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(tld)
  ) {
    throw new Error(`Invalid ICANN TLD: ${tld}`);
  }

  return tld;
}

export class SettingsStore {
  constructor(file = 'data/settings.json') {
    this.file = path.resolve(file);
    this.settings = this.load();
  }

  validate(input) {
    const primary = String(input.primary || '').trim();
    const secondary = String(input.secondary || '').trim();

    if (isIP(primary) !== 4) {
      throw new Error('Primary resolver must be a valid IPv4 address');
    }

    if (input.useSecondary && isIP(secondary) !== 4) {
      throw new Error('Secondary resolver must be a valid IPv4 address');
    }

    const source = input.icannTlds ??
      (input.icannDomains || []).map(domain =>
        String(domain).trim().split('.').pop()
      );

    if (!Array.isArray(source)) {
      throw new Error('ICANN TLDs must be an array');
    }

    const icannTlds = [
      ...new Set(source.map(normalizeTld))
    ].sort();

    return {
      primary,
      secondary,
      useSecondary: input.useSecondary === true,
      timeout: 5000,
      icannTlds
    };
  }

  load() {
    if (!fs.existsSync(this.file)) {
      return this.save(DEFAULTS);
    }

    const saved = JSON.parse(
      fs.readFileSync(this.file, 'utf8')
    );

    return this.validate({
      ...DEFAULTS,
      ...saved
    });
  }

  get() {
    return {
      ...this.settings,
      icannTlds: [...this.settings.icannTlds]
    };
  }

  save(input) {
    const next = this.validate({
      ...this.settings,
      ...input
    });

    fs.mkdirSync(path.dirname(this.file), {
      recursive: true
    });

    const temporary = `${this.file}.tmp`;

    fs.writeFileSync(
      temporary,
      JSON.stringify(next, null, 2),
      { mode: 0o600 }
    );

    fs.renameSync(temporary, this.file);

    this.settings = next;

    return this.get();
  }
}
