import dnsPacket from 'dns-packet';
import dgram from 'node:dgram';
import { randomInt } from 'node:crypto';
import { isIP } from 'node:net';

const TYPE_MAP = {
  A: 1,
  NS: 2,
  CNAME: 5,
  SOA: 6,
  PTR: 12,
  MX: 15,
  TXT: 16,
  AAAA: 28,
  SRV: 33,
  DS: 43,
  RRSIG: 46,
  NSEC: 47,
  DNSKEY: 48,
  NSEC3: 50,
  TLSA: 52
};

export class DnsResolver {
  constructor(options = {}) {
    this.primary = options.primary || '82.68.70.162';
    this.secondary = options.secondary || '82.68.70.163';
    this.useSecondary = options.useSecondary ?? true;
    this.timeout = options.timeout ?? 5000;
    this.port = options.port ?? 53;
    this.activeServer = null;
  }

  get servers() {
    return [
      this.primary,
      ...(this.useSecondary && this.secondary
        ? [this.secondary]
        : [])
    ];
  }

  async queryWire(name, type = 'A') {
    const typeName = typeof type === 'string'
      ? type.toUpperCase()
      : Object.keys(TYPE_MAP).find(
          key => TYPE_MAP[key] === type
        );

    if (!typeName || !TYPE_MAP[typeName]) {
      throw new Error(`Unsupported DNS type: ${type}`);
    }

    const normalizedName = name.endsWith('.')
      ? name
      : `${name}.`;

    const id = randomInt(0, 65536);

    const packet = dnsPacket.encode({
      type: 'query',
      id,
      flags: dnsPacket.RECURSION_DESIRED,
      questions: [{
        type: typeName,
        name: normalizedName,
        class: 'IN'
      }],
      additionals: [{
        type: 'OPT',
        name: '.',
        udpPayloadSize: 1232,
        flags: dnsPacket.DNSSEC_OK,
        options: []
      }]
    });

    let lastError;

    for (const server of this.servers) {
      try {
        const response = await this.sendQuery(
          server,
          packet,
          id
        );

        const decoded = dnsPacket.decode(response);
        const question = decoded.questions?.[0];

        if (
          decoded.id !== id ||
          decoded.type !== 'response' ||
          decoded.questions?.length !== 1 ||
          !question ||
          question.type !== typeName ||
          question.name.replace(/\.$/, '').toLowerCase() !==
            normalizedName.replace(/\.$/, '').toLowerCase()
        ) {
          throw new Error('Invalid DNS response');
        }

        if (decoded.flags & dnsPacket.TRUNCATED_RESPONSE) {
          throw new Error('Truncated DNS response');
        }

        this.activeServer = server;

        return response;
      } catch (error) {
        lastError = error;

        console.warn(
          `[DNS] ${server} failed: ${error.message}`
        );
      }
    }

    throw new Error(
      `All DNS resolvers failed: ${lastError?.message}`
    );
  }

  sendQuery(server, packet, id) {
    return new Promise((resolve, reject) => {
      const socket = dgram.createSocket('udp4');

      let settled = false;

      const finish = (error, result) => {
        if (settled) return;

        settled = true;
        clearTimeout(timer);

        socket.close();

        if (error) reject(error);
        else resolve(result);
      };

      const timer = setTimeout(() => {
        finish(new Error('DNS timeout'));
      }, this.timeout);

      socket.once('error', error => {
        finish(error);
      });

      socket.once('message', message => {
        finish(null, message);
      });

      socket.send(
        packet,
        this.port,
        server,
        error => {
          if (error) finish(error);
        }
      );
    });
  }

  async query(name, type = 'A') {
    return dnsPacket.decode(
      await this.queryWire(name, type)
    );
  }

  async resolveAddresses(hostname) {
    const host = String(hostname)
      .trim()
      .replace(/\.$/, '');

    if (!host) {
      throw new Error('Empty hostname');
    }

    const literalFamily = isIP(host);

    if (literalFamily) {
      return [{
        address: host,
        family: literalFamily
      }];
    }

    const results = await Promise.allSettled([
      this.query(host, 'A'),
      this.query(host, 'AAAA')
    ]);

    const addresses = [];

    for (const result of results) {
      if (result.status !== 'fulfilled') {
        continue;
      }

      const response = result.value;

      if (response.rcode !== 'NOERROR') {
        continue;
      }

      for (const record of response.answers || []) {
        if (record.type !== 'A' && record.type !== 'AAAA') {
          continue;
        }

        const address = record.data;
        const family = isIP(address);

        if (!family) continue;

        if (
          (record.type === 'A' && family !== 4) ||
          (record.type === 'AAAA' && family !== 6)
        ) {
          continue;
        }

        if (!addresses.some(
          item => item.address === address
        )) {
          addresses.push({
            address,
            family
          });
        }
      }
    }

    if (!addresses.length) {
      throw new Error(
        `No A or AAAA addresses returned for ${host}`
      );
    }

    return addresses;
  }

  lookup(hostname, options, callback) {
    if (typeof options === 'function') {
      callback = options;
      options = {};
    }

    options = options || {};

    const family = Number(options.family || 0);

    this.resolveAddresses(hostname)
      .then(addresses => {
        let filtered = addresses;

        if (family === 4 || family === 6) {
          filtered = addresses.filter(
            item => item.family === family
          );
        }

        if (!filtered.length) {
          throw new Error(
            `No IPv${family} address for ${hostname}`
          );
        }

        if (options.all) {
          callback(null, filtered);
        } else {
          callback(
            null,
            filtered[0].address,
            filtered[0].family
          );
        }
      })
      .catch(error => {
        callback(error);
      });
  }

  async resolveTLSA(domain, port = 443, proto = 'tcp') {
    if (!Number.isInteger(port) || port < 1 || port > 65535) {
      throw new Error('Invalid port');
    }

    if (!['tcp', 'udp', 'sctp'].includes(proto)) {
      throw new Error('Unsupported protocol');
    }

    const response = await this.query(
      `_${port}._${proto}.${domain}`,
      'TLSA'
    );

    if (response.rcode !== 'NOERROR') {
      throw new Error(
        `TLSA query failed: ${response.rcode}`
      );
    }

    return (response.answers || []).filter(
      record => record.type === 'TLSA'
    );
  }
}
