<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LetsDANE - Security Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
  <div>
    <h1>🔒 LetsDANE</h1>
    <p>DNSSEC · Handshake · DANE security manager</p>
  </div>
  <span id="overall-status" class="badge">Running</span>
</header>

<main>
  <section class="cards">
    <article class="card">
      <h2>Proxy</h2>
      <strong id="proxy-status">Loading</strong>
      <p id="proxy-address">127.0.0.1:8080</p>
    </article>
    <article class="card">
      <h2>Local CA</h2>
      <strong id="ca-status">Loading</strong>
      <p>Private key stored locally</p>
    </article>
  </section>

  <section class="section">
    <h2>DNS Trust & Resolvers</h2>
    <p class="muted">Configure your Handshake-aware DNS resolver.</p>

    <label for="primary">Primary resolver IPv4</label>
    <input id="primary" value="82.68.70.162">

    <div class="test-row">
      <button id="test-primary">Test primary</button>
      <span id="primary-result" class="result"></span>
    </div>

    <div class="active-info">
      Active resolver: <strong id="active-resolver">Not selected</strong>
    </div>
  </section>

  <section class="section">
    <h2>ICANN DNSSEC Trust TLDs</h2>

    <p class="muted">
      Every configured TLD uses independent DNSSEC validation
      against the IANA DNS root trust anchor.
    </p>

    <p class="muted">
      All other namespaces, including Handshake namespaces,
      use your configured resolver.
    </p>

    <h3>Add individual TLD</h3>

    <div class="test-row">
      <input id="icann-tld" placeholder="com">
      <button id="add-tld">Add TLD</button>
    </div>

    <h3>Bulk import TLDs</h3>

    <p class="muted">
      Paste newline-separated, comma-separated or space-separated
      TLDs. Leading dots are optional.
    </p>

    <textarea
      id="bulk-tlds"
      rows="8"
      placeholder="com&#10;org&#10;net&#10;info&#10;xyz&#10;app&#10;dev&#10;shop"
    ></textarea>

    <div class="test-row">
      <button id="import-tlds">Import TLDs</button>
      <button id="clear-bulk">Clear input</button>
    </div>

    <p id="domain-error" class="result failure"></p>
    <p id="import-result" class="result"></p>

    <h3>Configured ICANN TLDs</h3>

    <p>
      Total: <strong id="tld-count">0</strong>
    </p>

    <ul id="icann-tld-list"></ul>

    <div class="test-row">
      <button id="save-settings" class="primary">
        Save trust configuration
      </button>
      <button id="remove-all-tlds">Remove all</button>
    </div>

    <p id="trust-save-result" class="result"></p>
  </section>

  <section class="section">
    <h2>Security policy</h2>
    <ul>
      <li>Configured ICANN TLDs: Independent DNSSEC validation</li>
      <li>Other namespaces: Configured resolver</li>
      <li>DANE TLSA: Mandatory association matching</li>
      <li>Certificate mismatch: Connection blocked</li>
      <li>Missing or invalid TLSA: Connection blocked</li>
    </ul>
  </section>

  <section class="section">
    <h2>Certificate downloads</h2>
    <p><a href="/api/ca/cert.pem">Download root CA (PEM)</a></p>
    <p><a href="/api/ca/cert.der">Download root CA (DER)</a></p>
  </section>

  <section class="section">
    <h2>CA details</h2>
    <dl id="ca-info"></dl>
  </section>

  <section class="section">
    <h2>Installation</h2>
    <a href="/install.html">Firefox installation guide</a>
  </section>
</main>

<footer>LetsDANE JS · Local dashboard</footer>
<script src="/app.js"></script>
</body>
</html>
