#!/usr/bin/env node

import dns from 'node:dns';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

import { LocalCA } from './certificates/ca.js';
import { createDashboard } from './dashboard/server.js';
import { DaneProxy } from './proxy/http-proxy.js';
import { DnsResolver } from './dns/resolver.js';
import { SettingsStore } from './config/settings.js';
import { SecurityVerification } from './security/verification.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

async function main() {
  console.log("Let's DANE JS — Security manager");

  const settingsStore = new SettingsStore(
    path.join(__dirname, '../data/settings.json')
  );

  const settings = settingsStore.get();

  const resolver = new DnsResolver({
    ...settings,
    useSecondary: false
  });

  dns.setServers([settings.primary]);

  console.log('\nDNS configuration');
  console.log('Single upstream:', settings.primary);

  const ca = new LocalCA(
    path.join(__dirname, '../data/ca')
  );

  const caResult = await ca.ensure();

  console.log(caResult.created
    ? 'Generated local CA'
    : 'Loaded existing local CA');

  const securityVerifier = new SecurityVerification({
  resolver,
  trustMode: 'configured-resolver'
});

  const proxy = new DaneProxy(ca, {
  port: 8080,
  resolver,
  securityVerifier
});

  await proxy.start();

  const dashboard = createDashboard(ca, {
    port: 3000,
    proxyStatus: 'active',
    proxyAddress: '127.0.0.1:8080',
    settingsStore,
    resolver,
    securityVerifier
  });

  console.log('\n================================');
  console.log('LetsDANE started');
  console.log('Dashboard: http://127.0.0.1:3000');
  console.log('Proxy:     http://127.0.0.1:8080');
  console.log('================================');

  return { dashboard, proxy };
}

main().catch(error => {
  console.error('Startup failed:', error);
  process.exit(1);
});
